From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] nvidia-drm: include linux/version.h in fb sources

Keep this patch intentionally minimal for broad compatibility:
only add linux/version.h includes, no function prototype changes.

---
 nvidia-drm/nvidia-drm-fb.c | 1 +
 nvidia-drm/nvidia-drm-fb.h | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/kernel-dkms/nvidia-drm/nvidia-drm-fb.c b/kernel-dkms/nvidia-drm/nvidia-drm-fb.c
--- a/kernel-dkms/nvidia-drm/nvidia-drm-fb.c
+++ b/kernel-dkms/nvidia-drm/nvidia-drm-fb.c
@@ -33,6 +33,7 @@
 #include "nvidia-drm-format.h"
 
 #include <drm/drm_crtc_helper.h>
+#include <linux/version.h>
 
 static void __nv_drm_framebuffer_free(struct nv_drm_framebuffer *nv_fb)
 {
diff --git a/kernel-dkms/nvidia-drm/nvidia-drm-fb.h b/kernel-dkms/nvidia-drm/nvidia-drm-fb.h
--- a/kernel-dkms/nvidia-drm/nvidia-drm-fb.h
+++ b/kernel-dkms/nvidia-drm/nvidia-drm-fb.h
@@ -31,6 +31,8 @@
 #include <drm/drmP.h>
 #endif
 
+#include <linux/version.h>
+
 #include <drm/drm_framebuffer.h>
 
 #include "nvkms-kapi.h"
