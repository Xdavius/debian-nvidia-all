import { VerticalBox, HorizontalBox } from "std-widgets.slint";

component NvButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();

    height: 34px;
    border-radius: 10px;
    border-width: 1px;
    border-color: !root.enabled
        ? #4a4e57
        : (touch.pressed
            ? (root.primary ? #9fcd36 : #7fa8ea)
            : (touch.has-hover ? (root.primary ? #95c62e : #78a6f2) : (root.primary ? #6a9f08 : #41506e)));
    background: !root.enabled
        ? #2b3039
        : (root.primary
            ? (touch.pressed
                ? @linear-gradient(180deg, #5f9800 0%, #4b7b00 100%)
                : (touch.has-hover
                    ? @linear-gradient(180deg, #79b108 0%, #628f07 100%)
                    : @linear-gradient(180deg, #6fa206 0%, #587f06 100%)))
            : (touch.pressed
                ? @linear-gradient(180deg, #29364a 0%, #202a3a 100%)
                : (touch.has-hover
                    ? @linear-gradient(180deg, #2a3750 0%, #222d41 100%)
                    : @linear-gradient(180deg, #1f2938 0%, #1a2130 100%))));
    animate border-color { duration: 100ms; }

    Text {
        x: 12px;
        y: 7px;
        width: parent.width - 24px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled ? #f4f8ff : #aeb7c7;
        text: root.text;
        font-weight: 700;
        wrap: no-wrap;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SafeRoundedDropdown inherits Rectangle {
    in-out property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    private property <bool> open: false;
    private property <int> row-height: 30;
    private property <length> popup-height: model.length * row-height * 1px;
    public function close_menu() {
        root.open = false;
    }

    background: transparent;
    height: 34px;
    z: 100;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 34px;
        background: enabled
            ? (root.open
                ? @linear-gradient(180deg, #263245 0%, #1d2737 100%)
                : @linear-gradient(180deg, #1f2938 0%, #1a2130 100%))
            : #2b3039;
        border-color: !enabled
            ? #4a4e57
            : (header_touch.has-hover || root.open ? #78a6f2 : #41506e);
        border-width: 1px;
        border-radius: 10px;
        animate border-color { duration: 120ms; }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-radius: 10px;
            background: transparent;
            border-width: root.open ? 1px : 0px;
            border-color: #76b90066;
            animate border-width { duration: 120ms; }
        }

        Text {
            x: 10px;
            y: 8px;
            width: parent.width - 34px;
            text: root.model.length == 0
                ? "Aucune version"
                : (root.current-index >= 0 && root.current-index < root.model.length
                    ? root.model[root.current-index]
                    : root.model[0]);
            color: #e8eefc;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        Text {
            x: parent.width - 18px;
            y: 8px;
            text: root.open ? "▲" : "▼";
            color: root.open ? #93c7ff : #b8c7e6;
        }

        header_touch := TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => {
                root.open = !root.open;
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.cancel) {
                    root.open = false;
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 38px;
        z: 500;
        width: parent.width;
        height: root.popup-height;
        visible: root.open && root.model.length > 0;
        clip: true;
        background: @linear-gradient(180deg, #212d3f 0%, #161f2d 100%);
        border-color: #5f7ea8;
        border-width: 1px;
        border-radius: 10px;

        for entry[i] in root.model : Rectangle {
            x: 0px;
            y: i * root.row-height * 1px;
            width: parent.width;
            height: root.row-height * 1px;
            background: row_touch.has-hover
                ? #314561
                : (i == root.current-index ? #3a5274 : (Math.mod(i, 2) == 0 ? #1b2433 : #212c3d));
            animate background { duration: 90ms; }

            Rectangle {
                x: 0px;
                y: 4px;
                width: 3px;
                height: parent.height - 8px;
                border-radius: 2px;
                background: i == root.current-index ? #76b900 : #00000000;
            }

            Text {
                x: 12px;
                y: 7px;
                width: parent.width - 24px;
                text: entry;
                color: i == root.current-index ? #f3f7ff : #dfe7f8;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            row_touch := TouchArea {
                width: parent.width;
                height: parent.height;
                enabled: root.enabled;
                clicked => {
                    root.current-index = i;
                    root.open = false;
                    root.selected(i);
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.cancel) {
                        root.open = false;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <[string]> profile-model: [
        "latest",
        "recommended",
        "legacy580",
        "legacy470",
        "legacy390"
    ];
    in-out property <[string]> open-model: ["auto", "open", "proprietary"];

    in-out property <int> profile-index: 1;
    in-out property <int> open-index: 0;
    in-out property <string> status: "Pret";
    in-out property <string> logs: "";
    in-out property <bool> running: false;

    callback run();
    callback copy_logs();
    callback close_transients();

    min-width: 760px;
    min-height: 520px;
    max-width: 4000px;
    max-height: 3000px;
    preferred-width: 980px;
    preferred-height: 700px;
    title: "Debian NVIDIA Driver GUI";
    background: #161a22;

    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        background: #1b212c;
        border-color: #313949;
        border-width: 1px;
        border-radius: 14px;

        VerticalBox {
            padding: 16px;
            spacing: 10px;

            Rectangle {
                height: 64px;
                border-radius: 10px;
                background: @linear-gradient(90deg, #d70751 0%, #b70a4e 40%, #76b900 100%);

                Text {
                    x: 14px;
                    y: 16px;
                    text: "Debian NVIDIA Driver GUI";
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 800;
                }
            }

            Text {
                text: "Look GTK, esprit gaming, moteur CLI natif";
                color: #c6d0e1;
                font-size: 14px;
            }

            Rectangle {
                height: 1px;
                background: #2c3444;
            }

            Rectangle {
                background: #202734;
                border-color: #34405a;
                border-width: 1px;
                border-radius: 10px;
                z: 50;

                VerticalBox {
                    padding: 10px;
                    spacing: 8px;

                    HorizontalBox {
                        spacing: 10px;
                        Text {
                            text: "Choix de la version";
                            color: #e8eefc;
                            font-size: 16px;
                            width: 210px;
                            height: 34px;
                            vertical-alignment: center;
                        }
                        profile_dropdown := SafeRoundedDropdown {
                            horizontal-stretch: 1;
                            model: root.profile-model;
                            current-index: root.profile-index;
                            selected(i) => { root.profile-index = i; }
                            enabled: !root.running;
                        }
                    }
                }
            }

            Text {
                text: "Pour Latest et 580, kernel-open est force automatiquement. Pour 470/390, mode proprietaire.";
                color: #b5c0d6;
                wrap: word-wrap;
                font-size: 13px;
            }

            HorizontalBox {
                spacing: 8px;

                NvButton {
                    primary: true;
                    text: root.running ? "Installation en cours..." : "Lancer l'installation";
                    enabled: !root.running;
                    min-width: 190px;
                    clicked => { root.run(); }
                }

                NvButton {
                    text: "Copier les logs";
                    min-width: 120px;
                    clicked => { root.copy_logs(); }
                }

                Rectangle {
                    background: #151d2d;
                    border-color: #3e4b63;
                    border-width: 1px;
                    border-radius: 8px;
                    height: 32px;
                    horizontal-stretch: 1;
                    min-width: 260px;

                    Text {
                        x: 8px;
                        y: 7px;
                        width: parent.width - 14px;
                        text: root.status;
                        color: #dfe7f5;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #2c3444;
            }

            Text {
                text: "Journal systeme";
                color: #d6dfef;
                font-size: 16px;
                font-weight: 600;
            }

            Rectangle {
                background: #0f131b;
                border-color: #2d3648;
                border-width: 1px;
                border-radius: 8px;
                clip: true;
                vertical-stretch: 1;
                min-height: 260px;

                Text {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    text: root.logs;
                    color: #d5dceb;
                    wrap: word-wrap;
                    vertical-alignment: bottom;
                    font-size: 12px;
                }
            }
        }
    }

    close_transients => {
        profile_dropdown.close_menu();
    }
}
